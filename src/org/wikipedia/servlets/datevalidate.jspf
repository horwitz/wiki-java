<%--
    Fetches and validates interval inputs. Adds the following local variables:

        * earliest: the earliest date as a String, or the appropriate default value (pass to HTML)
        * latest: the latest date as a String, or the appropriate default value 
        * earliest_ldate: the earliest date as a LocalDate
        * latest_ldate: the latest date as a LocalDate
        * interval: the interval from the earliest timestamp to the latest (pass to Wiki.RequestHelper)

    If the interval is invalid, an "error" attribute is added to the request.
--%>

<%
    String earliest = ServletUtils.sanitizeForAttribute(request.getParameter("earliest"));
    String latest = ServletUtils.sanitizeForAttribute(request.getParameter("latest"));
    
    LocalDate earliest_ldate = earliest.equals("") ? null : LocalDate.parse(earliest);
    LocalDate latest_ldate = latest.equals("") ? null : LocalDate.parse(latest);

    // validate dates
    if (earliest_ldate != null && latest_ldate != null && earliest_ldate.isAfter(latest_ldate))
        request.setAttribute("error", "Earliest date is after latest date!");

    // cleanup
    Wiki.Interval interval = new Wiki.Interval(
        earliest_ldate == null ? null : earliest_ldate.atTime(OffsetTime.of(0, 0, 0, 0, ZoneOffset.UTC)),
        latest_ldate == null ? null : latest_ldate.atTime(OffsetTime.of(23, 59, 59, 0, ZoneOffset.UTC)));
%>
